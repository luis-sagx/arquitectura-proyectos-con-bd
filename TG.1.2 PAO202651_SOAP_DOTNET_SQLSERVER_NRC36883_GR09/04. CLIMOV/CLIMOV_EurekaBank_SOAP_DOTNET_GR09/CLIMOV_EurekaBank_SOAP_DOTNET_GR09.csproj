<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net10.0-android;net10.0-ios;net10.0-maccatalyst</TargetFrameworks>
    <TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net10.0-windows10.0.19041.0</TargetFrameworks>
    <OutputType>Exe</OutputType>
    <RootNamespace>CLIMOV_EurekaBank_SOAP_DOTNET_GR09</RootNamespace>
    <UseMaui>true</UseMaui>
    <SingleProject>true</SingleProject>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AndroidUseCleartextTraffic>true</AndroidUseCleartextTraffic>
    <ApplicationTitle>EurekaBank SOAP</ApplicationTitle>
    <ApplicationId>ec.edu.monster.eurekabank.soapdotnet</ApplicationId>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
  </PropertyGroup>
  <ItemGroup>
    <MauiImage Include="Resources\Images\*" />
  </ItemGroup>
  <!-- URL opcional del servidor: dotnet publish ... -p:ServerUrl=https://host (sin ella se usa 10.0.2.2 / localhost). -->
  <ItemGroup Condition="'$(ServerUrl)' != ''">
    <AssemblyMetadata Include="ServerUrl" Value="$(ServerUrl)" />
  </ItemGroup>
</Project>
